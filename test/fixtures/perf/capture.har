            "mimeType": "application/javascript",
            "size": 417,
            "text": "\nfetch(\"/analytics/beacon?event=pageview\", { method: \"POST\" });\nfetch(\"/api/products\").then((r) => r.json()).then((products) => {\n  document.getElementById(\"list\").innerHTML = products.map((p) => \"<li>\" + p.name + \"</li>\").join(\"\");\n});\n"
