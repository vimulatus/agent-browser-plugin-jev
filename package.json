{
  "name": "soab",
  "version": "0.5.2",
  "description": "Drives a browser from one goal or one policy",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:vimulatus/soab",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "soab": "./dist/main.js"
  },
  "files": [
    "dist",
    "policies",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "undici": "7.29.1",
    "yaml": "2.9.1"
  }
}
